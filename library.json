{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "LedPipelines",
  "version": "0.5.0",
  "description": "A library for building and composing complex LED effects. Renders through a pluggable output backend (FastLED, ESPHome, ...) and has no hard dependency on any LED driver.",
  "keywords": "led pipelines, ledpipelines, pipelines, led effects, effects, led strips, led lighting, lighting effects, lighting pipelines",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheVizWiz/LedPipelines"
  },
  "authors": [
    {
      "name": "TheVizWiz",
      "url": "https://vibhu.dev"
    }
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "comment": "src/main.cpp is a demo, so should not be included by others",
    "srcFilter": "+<*> -<main.cpp>"
  },
  "export": {
    "include": [
      "**/examples/*",
      "**/include/*",
      "**/src/*"
    ],
    "exclude": [
      "**/src/main.cpp"
    ]
  },
  "headers": [
    "LedPipelines.h"
  ],
  "examples": [
    {
      "name": "001. Basic Full Solid Color",
      "base": "examples/001_basic_full_solid_color",
      "files": [
        "001_basic_full_solid_color.cpp"
      ]
    },
    {
      "name": "002. Cycling Through Red Green and Blue Colors",
      "base": "examples/002_cycle_rgb_full_strip",
      "files": [
        "002_cycle_rgb_full_strip.cpp"
      ]
    },
    {
      "name": "003. A Bouncing Ball",
      "base": "examples/003_bouncing_ball",
      "files": [
        "003_bouncing_ball.cpp"
      ]
    },
    {
      "name": "004. A Bouncing Ball Another Way - Shared Effects",
      "base": "examples/004_shared_bouncing_ball",
      "files": [
        "004_shared_bouncing_ball.cpp"
      ]
    }
  ]
}